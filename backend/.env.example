DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=t2n_erp
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
PRIVATE_MEDIA_ROOT=

# Email (SMTP). Leave EMAIL_HOST empty during development: messages are then saved as files in EMAIL_FILE_PATH
# (default backend/sent_emails) and the app shows "Email is not set up on the server". The password stays here only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use TLS on port 587 (the usual choice) or SSL on port 465; not both.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# The address messages come from, for example accounts@example.com (defaults to EMAIL_HOST_USER).
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=20
EMAIL_FILE_PATH=
# The address people open the app at, used for links inside emails (for example https://erp.example.com).
APP_BASE_URL=
